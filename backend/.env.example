# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Required in non-development environments
ConnectionStrings__DBADashDB=Server=YOUR_SQL_SERVER;Database=DBADashDB;Trusted_Connection=True;TrustServerCertificate=true;
Jwt__Secret=replace-with-a-long-random-secret

# Optional: allow Vite dev server or reverse proxy origins
Cors__AllowedOrigins__0=http://localhost:5173

# Optional: one-time bootstrap for the first local admin user
LocalAuth__BootstrapAdminUsername=admin
LocalAuth__BootstrapAdminPassword=change-me-on-first-run
